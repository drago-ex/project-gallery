{
	"name": "drago-ex/project-gallery",
	"description": "Image gallery in the administration of Drago Project, for images in the content of articles and pages.",
	"type": "drago-tools-resource",
	"license": "MIT",
	"require": {
		"php": ">=8.3 <9",
		"ext-gd": "*",
		"ext-intl": "*",
		"nette/application": "^3.2",
		"nette/di": "^3.2",
		"nette/http": "^3.3",
		"nette/utils": "^4.0",
		"drago-ex/application": "^4.0",
		"drago-ex/component": "^3.0",
		"drago-ex/form": "^3.0",
		"drago-ex/project-auth": "^1.0 || ^2.0",
		"drago-ex/project-backend": "^1.0",
		"drago-ex/translator": "^4.0.1",
		"drago-ex/permission": "^2.0"
	},
	"suggest": {
		"drago-ex/project-permission": "Administration of custom roles and their privileges.",
		"drago-ex/project-backend-ui": "Administration layout; the gallery uses its content widget and gets its menu item from Backend/Gallery/7.menu.neon."
	},
	"require-dev": {
		"nette/tester": "^2.5",
		"phpstan/phpstan-nette": "^2.0",
		"drago-ex/project-tools": "^1.0"
	},
	"extra": {
		"drago-tools": {
			"install": {
				"copy": {
					"resources/app/Model": "app/Model",
					"resources/app/Presentation/Backend": "app/Presentation/Backend",
					"resources/assets/naja": "assets/naja"
				}
			}
		},
		"drago-translator": {
			"translation": "app/Presentation/Backend/Gallery/Translate"
		}
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s -C",
		"post-install-cmd": [
			"drago-install --dev",
			"drago-clean"
		],
		"post-update-cmd": [
			"drago-install --dev",
			"drago-clean"
		]
	}
}
