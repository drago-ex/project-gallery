{templateType App\Presentation\Backend\Gallery\Component\GalleryTemplate}
{embed '../../../Accessory/Widget/@modal.latte', modalId: $modalId, options: [theme: 'danger', confirm: true]}
	{block title}{_'Confirm delete'}{/block}
	{block body}
		{snippet content}
			<p n:if="$deleteName">
				{_'Are you sure you want to delete the image?'}
				<strong class="d-block text-body">{$deleteName}</strong>
			</p>
		{/snippet}
	{/block}
	{block footer}
		{snippet modal}
			{embed '../../../Accessory/Widget/@form.latte', name: 'delete', class: 'ajax', defaultClass: false}
				{import '../../../Accessory/Widget/@dismiss-button.latte'}
				{block form}
					{include buttonDismiss, type: 'modal', label: 'Cancel'}
					{include submit, name: 'confirm', class: 'btn btn-danger'}
				{/block}
			{/embed}
		{/snippet}
	{/block}
{/embed}

<header class="mb-4 pb-2 border-bottom d-flex flex-wrap justify-content-between align-items-end gap-3">
	<div>
		<h1 class="h5 mb-1">{_'Gallery'}</h1>
		<p class="small text-body-secondary mb-0">{_'Upload images and copy them into the texts.'}</p>
	</div>
	{* what the copy button of an image copies; the browser remembers the choice (assets/naja/gallery.js) *}
	<div class="d-flex align-items-center gap-2">
		<span class="small text-body-secondary">{_'Copy as'}</span>
		<span class="btn-group btn-group-sm gallery-copy-mode" role="group" aria-label="{_'Copy as'}">
			<input type="radio" class="btn-check" name="gallery-copy-mode" id="{$control->getUniqueId()}-texy" value="texy" autocomplete="off" checked>
			<label class="btn btn-outline-secondary" for="{$control->getUniqueId()}-texy">Texy</label>
			<input type="radio" class="btn-check" name="gallery-copy-mode" id="{$control->getUniqueId()}-path" value="path" autocomplete="off">
			<label class="btn btn-outline-secondary" for="{$control->getUniqueId()}-path">{_'Path'}</label>
		</span>
	</div>
</header>

{* the upload form only for those who may upload; the form is checked by the privilege "upload" anyway. The images
   are dropped on or chosen in a dropzone of compostrap: the file input covers the area and sends the form as soon as
   files are chosen (data-dropzone-submit), so the form has no button *}
{if $control->isAllowed('upload')}
	{snippet upload}
		{embed '../../../Accessory/Widget/@form.latte', name: 'upload', class: 'ajax mb-4', najaHistory: 'off'}
			{block form}
				<div class="col-12 form-error">
					<label class="dropzone">
						{input images, class => 'dropzone-input', accept => 'image/jpeg,image/png,image/gif,image/webp', data-dropzone-submit => true}
						<i class="bi bi-cloud-arrow-up dropzone-icon" aria-hidden="true"></i>
						<span class="dropzone-title">{_'Drop images here or'} <span class="dropzone-link">{_'choose them'}</span></span>
						<span class="dropzone-hint">{_'JPEG, PNG, GIF or WebP, at most 8 MB each.'}</span>
						<span class="dropzone-files" data-dropzone-files></span>
					</label>
				</div>
			{/block}
		{/embed}
	{/snippet}
{/if}

{* the tiles of the compostrap module gallery: the name stands at the bottom of an image and gives way to the buttons,
   which appear when the mouse is on the image or a button has the focus. The copy button copies the path of the image
   or its Texy markup, as chosen above (assets/naja/gallery.js). The preview opens the image in the lightbox of
   compostrap: the images form one group, so the arrows browse them; the script takes the translated labels of the
   lightbox from the data attributes of the list *}
{snippet images}
	<div n:if="$images" class="row row-cols-2 row-cols-sm-3 row-cols-lg-4 row-cols-xl-6 g-3"
		data-lightbox-dialog="{_'Image preview'}" data-lightbox-close="{_'Close'}"
		data-lightbox-previous="{_'Previous'}" data-lightbox-next="{_'Next'}">
		<div n:foreach="$images as $name" class="col">
			<figure class="gallery-item">
				<img src="{$path}/{$name}" alt="{$name}" loading="lazy">
				<figcaption class="gallery-caption" title="{$name}">
					<span class="gallery-name">{pathinfo($name, \PATHINFO_FILENAME)}</span><span class="gallery-ext">{pathinfo($name, \PATHINFO_EXTENSION)}</span>
				</figcaption>
				<div class="gallery-actions">
					<a href="{$path}/{$name}" class="btn btn-light btn-sm btn-icon" data-lightbox="gallery" data-caption="{$name}"
						aria-label="{_'Preview'}" data-tooltip>
						<i class="bi bi-zoom-in" aria-hidden="true"></i>
					</a>
					<button type="button" class="btn btn-light btn-sm btn-icon" data-gallery-copy="{$path}/{$name}"
						aria-label="{_'Copy for the content'}" data-tooltip>
						<i class="bi bi-copy" aria-hidden="true"></i>
					</button>
					<a n:if="$control->isAllowed('delete')" n:href="delete!, name: $name" class="btn btn-danger btn-sm btn-icon ajax" data-naja-history="off"
						aria-label="{_'Delete'}" data-tooltip>
						<i class="bi bi-trash" aria-hidden="true"></i>
					</a>
				</div>
			</figure>
		</div>
	</div>
	<p n:if="!$images" class="text-body-secondary mb-0">{_'The gallery has no images yet.'}</p>
{/snippet}
